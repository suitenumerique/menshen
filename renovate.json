{
  "extends": ["github>suitenumerique/ci//renovate/default"],
  "dependencyDashboard": true,
  "labels": ["dependencies", "noChangeLog", "automated"],
  "enabledManagers": ["github-actions", "pep621", "docker-compose", "dockerfile"],
  "schedule": ["before 9am on thursday"],
  "packageRules": [
    {
      "description": "Override the preset's per-group schedules",
      "matchPackageNames": ["*"],
      "schedule": ["before 9am on thursday"]
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "groupName": "allowed postgres versions",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "<17"
    }
  ]
}
